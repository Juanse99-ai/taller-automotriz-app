{
  "rewrites": [
    { "source": "/api/cuentti", "destination": "/api/cuentti.js" },
    { "source": "/mcp/cuentti", "destination": "/api/mcp/cuentti" },
    { "source": "/mcp/taller", "destination": "/api/mcp/taller" },
    { "source": "/((?!api|mcp|assets|fonts|.*\\..*).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
